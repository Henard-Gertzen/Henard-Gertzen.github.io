---
import Text from './Text.astro';
import { site } from '../site';
import { isTodo } from '../lib/todo';

interface Props {
  /** Heading level, so the form fits the page's outline. */
  level?: 2 | 3;
}

// The form posts straight to Kit (no third-party script). Until the form ID is
// set in src/site.ts it renders disabled.
const { level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const ready = !isTodo(site.kitFormId);
---

<section class="signup" aria-labelledby="signup-title">
  <Heading class="display scene-title" id="signup-title">New Posts by Email</Heading>
  <p class="dateline"><span>Occasional</span><span>One-click unsubscribe</span></p>
  <p class="signup-intro">Notes on harnesses, context and evals for teams using coding agents.</p>
  <form
    class="signup-form"
    method="post"
    action={ready ? `https://app.kit.com/forms/${site.kitFormId}/subscriptions` : undefined}
  >
    <label for="signup-email">Email address</label>
    <div class="signup-row">
      <input id="signup-email" type="email" name="email_address" autocomplete="email" required disabled={!ready} />
      <button class="button" type="submit" disabled={!ready}>Subscribe</button>
    </div>
    {
      !ready && (
        <p class="signup-todo">
          <Text text={site.kitFormId} />
        </p>
      )
    }
  </form>
  <p class="more">Or follow by <a href="/feed/">RSS</a></p>
</section>

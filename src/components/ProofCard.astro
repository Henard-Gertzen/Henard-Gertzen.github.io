---
import type { CollectionEntry } from 'astro:content';
import Metrics from './Metrics.astro';
import Text from './Text.astro';

interface Props {
  kind: string;
  title: string;
  summary: string;
  href: string;
  cta: string;
  metrics?: CollectionEntry<'caseStudies'>['data']['metrics'];
  highlights?: string[];
  headingLevel?: 2 | 3;
}

const { kind, title, summary, href, cta, metrics = [], highlights = [], headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  <p class="card-kind">{kind}</p>
  <Heading class="card-title"><a href={href}><Text text={title} /></a></Heading>
  <p class="card-summary"><Text text={summary} /></p>
  {metrics.length > 0 && <Metrics metrics={metrics.slice(0, 2)} compact />}
  {
    highlights.length > 0 && (
      <ul class="card-highlights">
        {highlights.slice(0, 2).map((h) => (
          <li>
            <Text text={h} />
          </li>
        ))}
      </ul>
    )
  }
  <p class="card-cta" aria-hidden="true">{cta} →</p>
</article>

---
import { plateCredits } from '../lib/plates';
import { site } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{site.name}</a>
  <p>Secunda, South Africa, <time class="local-time">UTC+2</time></p>
  <ul class="footer-links">
    <li><a href={`mailto:${site.email}`}>Email</a></li>
    <li><a href={site.links.linkedin} rel="noopener">LinkedIn</a></li>
    <li><a href={site.links.github} rel="noopener">GitHub</a></li>
    <li><a href="/feed/">RSS</a></li>
  </ul>
  <p>© {year}</p>
  <p class="footer-credits">
    {/* One line on purpose: line breaks here would render as spaces before the commas. */}
    Illustrations made from Pixabay photos: {plateCredits.map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.label}</a></>)}.
  </p>
</footer>

<script>
  // Swap the static "UTC+2" for Henard's current local time.
  const el = document.querySelector<HTMLTimeElement>('.local-time');
  const format = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Johannesburg' });
  const tick = () => {
    if (el) el.textContent = `${format.format(new Date())} SAST`;
  };
  tick();
  setInterval(tick, 30_000);
</script>

---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site';

const nav = [
  { href: '/case-studies/', label: 'Case studies' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/talks/', label: 'Talks' },
  { href: '/about/', label: 'About' },
  { href: '/work-with-me/', label: 'Work with me', cta: true },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand-mark" aria-hidden="true"></span>{site.name}
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map(({ href, label, cta }) => (
            <li>
              <a href={href} class:list={{ 'nav-cta': cta }} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

---
import ThemeSwitch from './ThemeSwitch.astro';
import { site } from '../site';

const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
    <span class="brand-mark" aria-hidden="true"></span>{site.name}
  </a>
  <nav class="site-nav" aria-label="Main">{nav.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}</nav>
  <div class="header-tools">
    <ThemeSwitch />
    <details class="menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M3 5.5 H17 M3 10 H17 M3 14.5 H17" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
      </summary>
      <nav aria-label="Menu">{nav.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}</nav>
    </details>
  </div>
</header>

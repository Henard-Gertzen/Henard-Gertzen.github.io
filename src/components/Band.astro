---
// A full-width section on the darker, textured band, optionally with a faint
// photo behind it (decorative, so it has empty alt text and loads lazily).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo?: ImageMetadata;
  labelledby?: string;
}

const { photo, labelledby } = Astro.props;
const Tag = labelledby ? 'section' : 'div';
---

<Tag class="band" aria-labelledby={labelledby}>
  {photo && <Image class="band-photo" src={photo} alt="" widths={[640, 1280]} sizes="100vw" loading="lazy" />}
  <slot />
</Tag>

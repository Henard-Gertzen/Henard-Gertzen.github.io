---
import type { CollectionEntry } from 'astro:content';
import MaybeLink from './MaybeLink.astro';
import Text from './Text.astro';
import Tags from './Tags.astro';
import { formatDate, isoDate, postHref } from '../lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li class="post">
        <p class="post-meta">
          <time datetime={isoDate(post.data.date)}>
            <Text text={formatDate(post.data.date)} />
          </time>
          {post.data.outlet && <span> / {post.data.outlet}</span>}
          {post.data.draft && <span class="badge">Draft</span>}
        </p>
        <Heading>
          <MaybeLink href={postHref(post)}>
            <Text text={post.data.title} />
          </MaybeLink>
        </Heading>
        <p>
          <Text text={post.data.description} />
        </p>
        {post.data.tags.length > 0 && <Tags tags={post.data.tags} chips />}
      </li>
    ))
  }
</ol>

---
// A project as a scene card: title, kind and status, screenshot, summary, highlights, links and
// stack. The home page shows the first three highlights; `full` (the Projects page) shows them
// all, plus the project's Markdown body if it has one.
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MaybeLink from './MaybeLink.astro';
import Text from './Text.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  full?: boolean;
}

const { project, full = false } = Astro.props;
const { id, data } = project;
const Content = full && project.body?.trim() ? (await render(project)).Content : undefined;
const highlights = full ? data.highlights : data.highlights.slice(0, 3);
---

<article class="card scene" id={id}>
  <h3 class="display scene-title"><Text text={data.title} /></h3>
  <p class="dateline"><span><Text text={data.kind} /></span><span><Text text={data.status} /></span></p>
  <div class="measure">
    {
      data.cover && (
        <figure class="shot">
          <Image
            src={data.cover.src}
            alt={data.cover.alt}
            widths={[480, 720, 1080]}
            sizes="(min-width: 48rem) 36rem, calc(100vw - 4rem)"
            fetchpriority="low"
          />
          {data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}
        </figure>
      )
    }
    <p><Text text={data.summary} /></p>
    {
      highlights.length > 0 && (
        <ul class="notes">
          {highlights.map((h) => (
            <li>
              <Text text={h} />
            </li>
          ))}
        </ul>
      )
    }
    {
      Content && (
        <div class="prose">
          <Content />
        </div>
      )
    }
  </div>
  {
    data.links.length > 0 && (
      <p class="more">
        {data.links.map((link) => (
          <MaybeLink href={link.href}>{link.label}</MaybeLink>
        ))}
      </p>
    )
  }
  {
    data.stack.length > 0 && (
      <p class="chips">
        <span>Built with</span>
        {data.stack.map((s) => (
          <span class="ref">
            <Text text={s} />
          </span>
        ))}
      </p>
    )
  }
</article>

import Base from '../layouts/Base.astro';
---

<Base title="Check your inbox" description="Confirm your subscription to Henard Gertzen’s writing." noindex>
  <div class="not-found narrow">
    <p class="kicker">Almost there</p>
    <h1>Check your inbox</h1>

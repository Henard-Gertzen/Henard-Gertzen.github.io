---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import headshot from '../assets/henard-gertzen.png';
import { getCaseStudies, isoDate, published } from '../lib/content';
import { pages, site } from '../site';

const meta = pages['/'];
const month = (date: Date) => date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const log = (await getCollection('log')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "Built": featured case studies first, then featured projects in their page order.
const groupOrder = { tooling: 0, games: 1, university: 2 } as const;
const [studies, projects] = await Promise.all([
  getCaseStudies(),
  getCollection('projects', (entry) => entry.data.featured && published(entry)),
]);
const built = [
  ...studies
    .filter((s) => s.data.featured)
    .map((s) => ({ title: s.data.title, href: `/case-studies/${s.id}/`, line: s.data.summary })),
  ...projects
    .sort((a, b) => groupOrder[a.data.group] - groupOrder[b.data.group] || a.data.order - b.data.order)
    .map((p) => ({ title: p.data.title, href: `/projects/#${p.id}`, line: p.data.tagline ?? p.data.kind })),
];
---

<Base title={meta.title} description={meta.description} image="/og/index.png">
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <figure class="portrait">
        <Image src={headshot} alt="Henard Gertzen" widths={[200, 400]} sizes="(min-width: 48rem) 11rem, 7rem" loading="eager" />
      </figure>
      <div class="hero-text">
        <h1 id="hero-title">Hi, I’m Henard. {site.hero.title}</h1>
        <p>
          I’m a full-stack developer on .NET and Angular in Secunda, South Africa, and I make games with coding agents on
          the side.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="recent-title">
      <h2 class="section-title" id="recent-title">Recently</h2>
      <ol class="dated">
        {
          log.map((entry) => (
            <li>
              <time datetime={isoDate(entry.data.date)}>{month(entry.data.date)}</time>
              <span>{entry.data.href ? <a href={entry.data.href}>{entry.data.text}</a> : entry.data.text}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="built-title">
      <h2 class="section-title" id="built-title">Built</h2>
      <ul class="built">
        {
          built.map((item) => (
            <li>
              <a href={item.href}>{item.title}</a>
              <span>{item.line}</span>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/projects/">All projects, including the games and university work</a></p>
    </section>

    <div class="section">
      <Signup />
    </div>
  </div>
</Base>

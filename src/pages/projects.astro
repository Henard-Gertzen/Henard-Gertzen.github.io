---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/content';
import { pages } from '../site';

const meta = pages['/projects/'];
const [tooling, games, university] = await Promise.all([
  getProjects('tooling'),
  getProjects('games'),
  getProjects('university'),
]);

const groups = [
  {
    id: 'tooling',
    icon: 'gauge',
    kicker: 'Tooling',
    title: 'Harnesses and Tools for Coding Agents',
    intro: 'Tooling that makes coding agents follow a team’s standards, and measures whether they actually do.',
    items: tooling,
  },
  {
    id: 'games',
    icon: 'anvil',
    kicker: 'Games',
    title: 'Games Built with Coding Agents',
    intro:
      'These are built by directing Claude Code agents: written briefs, long-running sessions, headless bot playtests and automated tests that keep the agents honest. I make them in my own time.',
    items: games,
  },
  {
    id: 'university',
    icon: 'cap',
    kicker: 'University',
    title: 'Group Projects at North-West University',
    intro: 'Group projects from my BSc IT at North-West University, 2021 to 2024.',
    items: university,
  },
] as const;
const shown = groups.filter((group) => group.items.length > 0);
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<Base title={meta.title} description={meta.description} image="/og/projects.png">
  <PageHead icon="wrench" kicker="Tooling, games and university" tag={tooling.length + games.length + university.length} title="Projects">
    <p>
      Tooling that makes coding agents follow a team’s standards, games I build by directing those agents, and my
      university projects.
    </p>
    <nav class="toc" aria-label="Sections">
      {shown.map((group, i) => <a href={`#${group.id}`}><span>{number(i)}</span>{group.kicker}</a>)}
    </nav>
  </PageHead>

  {
    shown.map((group, i) => (
      <section class="section-block" id={group.id} aria-labelledby={`${group.id}-title`}>
        <article class="card">
          <Emblem icon={group.icon} />
          <p class="kicker">
            <b>{number(i)}</b> {group.kicker}
          </p>
          <h2 class="display" id={`${group.id}-title`}>
            {group.title}
          </h2>
          <div class="measure">
            <p class="dropcap">{group.intro}</p>
          </div>
        </article>
        {group.items.map((project) => (
          <ProjectCard project={project} full />
        ))}
      </section>
    ))
  }
</Base>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { pages, site } from '../site';
import { isTodo } from '../lib/todo';

const meta = pages['/contact/'];
const formReady = !isTodo(site.web3formsKey);
---

<Base title={meta.title} description={meta.description} image="/og/contact.png">
  <PageHead icon="signal" kicker="Remote, UTC+2" title="Contact">
    <p>What I do day to day, and how to reach me.</p>
  </PageHead>

  <section class="card scene" aria-labelledby="dev-title">
    <h2 class="display scene-title" id="dev-title">Full-Stack Developer</h2>
    <p class="dateline"><span>.NET and Angular</span><span>Remote</span></p>
    <div class="measure">
      <p>I build and maintain enterprise software on .NET and Angular, working remotely as part of a product team.</p>
      <dl class="parts">
        <div><dt>Stack</dt><dd>C# and .NET (ABP Framework), Angular, TypeScript</dd></div>
        <div><dt>Before</dt><dd>React and Next.js front-ends</dd></div>
        <div><dt>Where</dt><dd>Remote, from {site.location}</dd></div>
      </dl>
    </div>
  </section>

  <section class="card scene" aria-labelledby="ai-title">
    <h2 class="display scene-title" id="ai-title">AI Harnesses for Coding Agents</h2>
    <p class="dateline"><span>Claude Code</span><span>Harness, context, measurement</span></p>
    <div class="measure">
      <p>
        Setting up Claude Code so it follows a team’s conventions, and checking whether it actually does. The tooling
        is on the <a href="/projects/#tooling">Projects</a> page.
      </p>
      <ul class="notes">
        <li>
          <strong>Harness:</strong> shared settings, hooks, permissions and tools, so every developer’s agent works the
          same way.
        </li>
        <li><strong>Context:</strong> conventions written where the agent reads them, with real examples from the codebase.</li>
        <li><strong>Measurement:</strong> every change gets a number, like the 31% token saving from one harness default.</li>
      </ul>
    </div>
  </section>

  <TitleBlock id="contact" title="Get in Touch" sheet="Secunda, South Africa" foot={['Drawn by H. Gertzen', 'Remote, UTC+2']}>
    <div class="tb-cell">
      <h3>Email</h3>
      <p class="big"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="tb-cell">
      <h3>Elsewhere</h3>
      <p class="links">
        <a href={site.links.linkedin} rel="noopener">LinkedIn</a>
        <a href={site.links.github} rel="noopener">GitHub</a>
        {!isTodo(site.cv) && <a href={site.cv}>CV (PDF)</a>}
      </p>
    </div>
    {
      formReady && (
        <div class="tb-cell wide">
          <h3>Or send a message</h3>
          <form class="contact-form" action="https://api.web3forms.com/submit" method="post">
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New message from henard-gertzen.github.io" />
            <input type="hidden" name="from_name" value="Portfolio contact form" />
            <input type="hidden" name="redirect" value={new URL('/contact/sent/', site.url).href} />
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="field">
              <label for="contact-name">Your name</label>
              <input id="contact-name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="contact-email">Your email</label>
              <input id="contact-email" type="email" name="email" autocomplete="email" required />
            </div>
            <div class="field field-wide">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="6" required></textarea>
            </div>
            <button class="button" type="submit">Send message</button>
          </form>
        </div>
      )
    }
  </TitleBlock>
</Base>

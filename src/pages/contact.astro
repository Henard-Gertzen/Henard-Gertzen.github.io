---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import circuitBoard from '../assets/backgrounds/circuit-board.jpg';
import { pages, site } from '../site';
import { isTodo } from '../lib/todo';

const meta = pages['/contact/'];
const formReady = !isTodo(site.web3formsKey);
---

<Base title={meta.title} description={meta.description} image="/og/contact.png">
  <header class="page-head wrap">
    <h1>Contact</h1>
    <p class="lede">What I do day to day, and how to reach me.</p>
  </header>

  <div class="wrap">
    <div class="roles">
      <section aria-labelledby="dev-title">
        <h2 id="dev-title">Full-stack developer</h2>
        <p>
          I build and maintain enterprise software on .NET and Angular, working remotely as part of a product team.
        </p>
        <dl class="facts">
          <div>
            <dt>Stack</dt>
            <dd>C# and .NET (ABP Framework), Angular, TypeScript</dd>
          </div>
          <div>
            <dt>Before</dt>
            <dd>React and Next.js front-ends</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Remote, from {site.location}</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="ai-title">
        <h2 id="ai-title">AI harnesses for coding agents</h2>
        <p>
          Setting up Claude Code so it follows a team’s conventions, and checking whether it actually does. The tooling
          is on the <a href="/projects/">Projects</a> page.
        </p>
        <ul class="marked">
          <li>
            <strong>Harness:</strong> shared settings, hooks, permissions and tools, so every developer’s agent works the
            same way.
          </li>
          <li>
            <strong>Context:</strong> conventions written where the agent reads them, with real examples from the codebase.
          </li>
          <li>
            <strong>Measurement:</strong> every change gets a number, like the 31% token saving from one harness default.
          </li>
        </ul>
      </section>
    </div>

  </div>

  <Band photo={circuitBoard} labelledby="contact-title">
    <div class="wrap contact">
      <h2 class="section-title" id="contact-title">Get in touch</h2>
      <div>
        <p>
          Email me at <a href={`mailto:${site.email}`}>{site.email}</a>{formReady && ', or use the form'}. I’m also on
          <a href={site.links.linkedin} rel="noopener">LinkedIn</a> and
          <a href={site.links.github} rel="noopener">GitHub</a>.
        </p>
        {
          !isTodo(site.cv) && (
            <p class="contact-cv">
              <a href={site.cv}>Download my CV (PDF)</a>
            </p>
          )
        }
      </div>
      {
        formReady && (
          <form class="contact-form" action="https://api.web3forms.com/submit" method="post">
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New message from henard-gertzen.github.io" />
            <input type="hidden" name="from_name" value="Portfolio contact form" />
            <input type="hidden" name="redirect" value={new URL('/contact/sent/', site.url).href} />
            <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="field">
              <label for="contact-name">Your name</label>
              <input id="contact-name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="contact-email">Your email</label>
              <input id="contact-email" type="email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="6" required></textarea>
            </div>
            <button class="button button-primary" type="submit">Send message</button>
          </form>
        )
      }
    </div>
  </Band>
</Base>

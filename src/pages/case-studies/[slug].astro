---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Metrics from '../../components/Metrics.astro';
import PageHead from '../../components/PageHead.astro';
import Signup from '../../components/Signup.astro';
import Text from '../../components/Text.astro';
import { getCaseStudies } from '../../lib/content';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const { data } = study;
const { Content } = await render(study);
---

<Base title={data.title} description={data.summary} image={`/og/case-studies/${study.id}.png`} type="article">
  <article>
    <PageHead icon="chart" kicker="Case study" tag={data.draft ? 'Draft' : undefined} title={data.title} back={{ href: '/case-studies/', label: 'Case studies' }}>
      <p><Text text={data.summary} /></p>
    </PageHead>

    <section class="card" aria-labelledby="glance-title">
      <p class="kicker" id="glance-title">At a Glance</p>
      <dl class="readout readout-3">
        <div><dt>Client</dt><dd class="readout-text"><Text text={data.client} /></dd></div>
        <div><dt>My role</dt><dd class="readout-text"><Text text={data.role} /></dd></div>
        <div><dt>Period</dt><dd class="readout-text"><Text text={data.period} /></dd></div>
      </dl>
      {
        data.metrics.length > 0 && (
          <div class="measure results">
            <p class="ledger-legend">
              <span>Results</span>
              <span aria-hidden="true">before → after</span>
            </p>
            <Metrics metrics={data.metrics} />
          </div>
        )
      }
    </section>

    <div class="card reading">
      <div class="prose measure">
        <Content />
        <h2 id="stack">Stack</h2>
        <p>
          <Text text={`${new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(data.stack)}.`} />
        </p>
      </div>
      <p class="more">
        <span>Questions about this? I’m happy to talk through how it works and what I’d do differently.</span>
        <a href="/contact/">Get in touch</a>
      </p>
    </div>
  </article>

  <article class="card scene">
    <Signup />
  </article>
</Base>

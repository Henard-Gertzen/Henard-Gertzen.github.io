---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Metrics from '../../components/Metrics.astro';
import Signup from '../../components/Signup.astro';
import Text from '../../components/Text.astro';
import { getCaseStudies } from '../../lib/content';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const { data } = study;
const { Content } = await render(study);
---

<Base title={data.title} description={data.summary} image={`/og/case-studies/${study.id}.png`} type="article">
  <article>
    <header class="article-head narrow">
      <p class="kicker">
        <a href="/case-studies/">Case study</a>
        {data.draft && <span class="badge">Draft</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="lede"><Text text={data.summary} /></p>
      <dl class="article-meta">
        <div>
          <dt>Client</dt>
          <dd><Text text={data.client} /></dd>
        </div>
        <div>
          <dt>My role</dt>
          <dd><Text text={data.role} /></dd>
        </div>
        <div>
          <dt>Period</dt>
          <dd><Text text={data.period} /></dd>
        </div>
      </dl>
    </header>

    <div class="narrow">
      {
        data.metrics.length > 0 && (
          <section class="glance" aria-labelledby="glance-title">
            <div class="ledger-legend">
              <h2 id="glance-title">Results at a glance</h2>
              <span class="kicker" aria-hidden="true">
                before → after
              </span>
            </div>
            <Metrics metrics={data.metrics} />
          </section>
        )
      }

      <div class="prose">
        <Content />
        <h2 id="stack">Stack</h2>
        <ul class="chips" aria-label="Stack">
          {
            data.stack.map((item) => (
              <li>
                <Text text={item} />
              </li>
            ))
          }
        </ul>
      </div>

      <footer class="article-foot">
        <section class="cta-panel" aria-labelledby="cta-title">
          <h2 id="cta-title">Want this for your team?</h2>
          <p>I run Claude Code rollouts for .NET and Angular teams, and I’m open to AI enablement roles.</p>
          <a class="button button-primary" href="/work-with-me/">Work with me</a>
        </section>
        <Signup />
      </footer>
    </div>
  </article>
</Base>

---
import Base from '../../layouts/Base.astro';
import ProofCard from '../../components/ProofCard.astro';
import Signup from '../../components/Signup.astro';
import { getCaseStudies } from '../../lib/content';
import { pages } from '../../site';

const meta = pages['/case-studies/'];
const studies = await getCaseStudies();
---

<Base title={meta.title} description={meta.description} image="/og/case-studies.png">
  <header class="page-head wrap">
    <p class="kicker">Case studies</p>
    <h1>Coding agents on real teams, measured</h1>
    <p class="lede">
      Each one follows the same shape: the context, the problem, what I built, how I measured it against a baseline,
      the results, and what didn’t work. Clients are anonymised.
    </p>
  </header>

  {
    studies.length === 0 && (
      <section class="section wrap" aria-labelledby="progress-title">
        <div class="section-head">
          <h2 id="progress-title">The first one is in progress</h2>
        </div>
        <p class="section-intro">
          It covers making Claude Code follow a team’s ABP and Angular conventions, with baseline and after numbers.
          Until it’s ready, my agent tooling is on the Projects page.
        </p>
        <div class="section-actions">
          <a class="button button-primary" href="/projects/">See the projects</a>
        </div>
        <div class="section">
          <Signup />
        </div>
      </section>
    )
  }

  <div class="wrap">
    <div class="card-grid">
      {
        studies.map((s) => (
          <ProofCard
            kind="Case study"
            title={s.data.title}
            summary={s.data.summary}
            href={`/case-studies/${s.id}/`}
            cta="Read the case study"
            metrics={s.data.metrics}
            headingLevel={2}
          />
        ))
      }
    </div>
  </div>
</Base>

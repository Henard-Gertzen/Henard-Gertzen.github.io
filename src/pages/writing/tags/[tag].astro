---
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, tagSlug } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'posts'>[];
}

const { tag, posts } = Astro.props;
---

<Base title={`Writing tagged “${tag}”`} description={`Posts about ${tag} by Henard Gertzen.`} image="/og/writing.png">
  <PageHead icon="nib" kicker="Topic" tag={posts.length} title={`Posts About ${tag}`} back={{ href: '/writing/', label: 'Writing' }} />
  <section class="card" aria-label="Posts">
    <div class="measure">
      <PostList posts={posts} />
    </div>
  </section>
</Base>

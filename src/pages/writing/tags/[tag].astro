---
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, tagSlug } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'posts'>[];
}

const { tag, posts } = Astro.props;
---

<Base title={`Writing tagged “${tag}”`} description={`Posts about ${tag} by Henard Gertzen.`} image="/og/writing.png">
  <header class="page-head wrap">
    <p class="back"><a href="/writing/">Writing</a></p>
    <h1>Posts about {tag}</h1>
  </header>
  <div class="wrap">
    <PostList posts={posts} />
  </div>
</Base>

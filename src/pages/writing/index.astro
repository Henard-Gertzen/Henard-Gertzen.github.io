---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import Signup from '../../components/Signup.astro';
import Tags from '../../components/Tags.astro';
import { getPosts } from '../../lib/content';
import { pages } from '../../site';

const meta = pages['/writing/'];
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title={meta.title} description={meta.description} image="/og/writing.png">
  <PageHead icon="nib" kicker="Notes on coding agents" tag={posts.length} title="Writing">
    <p>
      What coding agents actually are, and how to make them write code your team would merge. Follow by
      <a href="/feed/">RSS</a> or email.
    </p>
  </PageHead>

  <section class="card" aria-label="Posts">
    {
      tags.length > 0 && (
        <nav class="tag-filter" aria-label="Topics">
          <span>Topics</span>
          <Tags tags={tags} chips />
        </nav>
      )
    }
    <div class="measure">
      <PostList posts={posts} />
    </div>
  </section>

  <article class="card scene">
    <Signup />
  </article>
</Base>

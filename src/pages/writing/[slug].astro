---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Signup from '../../components/Signup.astro';
import Tags from '../../components/Tags.astro';
import Text from '../../components/Text.astro';
import { formatDate, getPosts, isoDate, readingMinutes } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Posts published elsewhere link out, so they get no page here.
  return posts
    .filter((post) => !post.data.externalUrl)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const kicker = `${formatDate(data.date)} / ${readingMinutes(post.body)} min read`;
---

<Base title={data.title} description={data.description} image={`/og/writing/${post.id}.png`} type="article">
  <article>
    <PageHead kicker={kicker} tag={data.draft ? 'Draft' : undefined} title={data.title} back={{ href: '/writing/', label: 'Writing' }}>
      <p><Text text={data.description} /></p>
      {
        data.updated && (
          <p class="page-note">
            Updated <time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time>
          </p>
        )
      }
    </PageHead>

    <div class="card reading">
      <div class="prose measure">
        <Content />
      </div>
      {
        data.tags.length > 0 && (
          <p class="chips">
            <span>Filed under</span>
            <Tags tags={data.tags} chips />
          </p>
        )
      }
    </div>
  </article>

  <article class="card scene">
    <Signup />
  </article>
</Base>

---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import Tags from '../../components/Tags.astro';
import Text from '../../components/Text.astro';
import { formatDate, getPosts, isoDate, readingMinutes } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Posts published elsewhere link out, so they get no page here.
  return posts
    .filter((post) => !post.data.externalUrl)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<Base title={data.title} description={data.description} image={`/og/writing/${post.id}.png`} type="article">
  <article>
    <header class="article-head narrow">
      <p class="kicker">
        <a href="/writing/">Writing</a>
        {data.draft && <span class="badge">Draft</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="lede"><Text text={data.description} /></p>
      <p class="post-meta">
        <time datetime={isoDate(data.date)}><Text text={formatDate(data.date)} /></time>
        <span>{readingMinutes(post.body)} min read</span>
        {data.updated && <span>Updated <time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time></span>}
      </p>
    </header>

    <div class="narrow">
      <div class="prose">
        <Content />
      </div>
      <footer class="article-foot">
        <Tags tags={data.tags} />
        <Signup />
      </footer>
    </div>
  </article>
</Base>
